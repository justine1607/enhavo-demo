<div class="menu-container" data-sub-menu-target="menuContainer">
    {% if navigation is defined and navigation.main %}
        <ul class="menu">
            {% for node in navigation.main.nodes %}
                <li class="nav-item {% if node.children|length > 0 %}has-submenu{% endif %}">
                    {% if node.name == "page"%}
                        <a href="{{ node.subject.url }}" class="">{{ node.label }}</a>
                    {% elseif node.name == "submenu" and node.children|length > 0 %}
                        <a  class="submenu-container" href="{{ node.subject.url }}" class="headline" data-sub-menu-target="trigger">{{ node.label ?? node.subject.title }}</a>
                        <ul class="sub-menu" data-sub-menu-target="submenu">
                            {% for node in node.children %}
                                <li class="sub-menu-list">
                                    <a href="/show" class="list-font">{{ node.label ?? node.subject.title }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>