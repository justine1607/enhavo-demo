{#{{ dump(block) }}#}
<div class="block-hero {{ block.layout }}-flex">
    <div class="theme-container">
        <div class="flex">
            <div class="media-container">
                <div class="img-wrapper">
                    <img src="{{ media_url(block.layer1) }}" alt="{{ media_parameter(block.layer1,'alt')}}" class="hero-media">
                    <img src="{{ media_url(block.layer2) }}" alt="{{ media_parameter(block.layer2,'alt') }}" class="hero-media">

                </div>
            </div>
            <div class="text-container {{ block.layout }}-text-container">
                <div class="overline theme-overline">{{ block.overline|html_sanitize }}</div>
                <div class=" theme-headline headline boldHeadline">{{ block.headline|html_sanitize }}</div>
                <div class="copy">{{ block.text|html_sanitize }}</div>
            </div>
        </div>
        {% for item in block.items %}
            <div class="background-{{ item.color }}">
                <div class="label">{{ item.label }}</div>
            </div>
        {% endfor %}
    </div>
</div>
