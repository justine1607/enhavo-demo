{% if nagScreen %}
<div class="block-nag-screen">
    <div class="theme-container">
        <div class="wrapper">
            <div class="ex-toggle">
                <div class="lines"></div>
            </div>
            <div class="flex">
                <div class="text-container">
                    <div class="overline theme-overline">{{ nagScreen.overline|html_sanitize }}</div>
                    <div class="headline theme-headline boldHeadline">{{ nagScreen.title|html_sanitize }}</div>
                    <div class="copy">{{ nagScreen.text|html_sanitize }}</div>
                        <form class="nag-screen-form">
                            <button class="theme-button" type="submit">{{ nagScreen.buttonTitle|default('Senden') }}</button>
                        </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endif %}
