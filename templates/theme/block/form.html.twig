<div class="block-form">
    <div class="theme-container">
        <div class="form-grid">
            <div class="text-container">
                <div class="theme-headline boldHeadline">{{ block.headline|html_sanitize }}</div>
                <div class="theme-overline">{{ block.overline|html_sanitize }}</div>
                <div class="text ">{{ block.text|html_sanitize }}</div>
            </div>
            <form class="form" data-controller="form" novalidate>
                {% for item in block.form %}
                    {% set input_id = item.label|replace({' ': '-'})|lower %}
                    <label for="{{ input_id }}" class="label">{{ item.label|html_sanitize }}</label>
                    {% if item.type == 'select' %}
                        <select name="{{ item.label }}" id="{{ input_id }}" required="{{ item.is_required ? 'required' }}">
                            <option value="">Auswählen</option>
                            {% for option in item.options %}
                                <option value="{{ option.value }}">{{ option.label }}</option>
                            {% endfor %}
                        </select>
                        {% elseif item.type == 'textarea' %}
                            <textarea name="{{ item.label }}" id="{{ input_id }}" placeholder="{{ item.placeholder|html_sanitize }}" required="{{ item.is_required ? 'required' }}"></textarea>
                        {% else %}
                        <input type="{{ item.type }}" name="{{ item.label }}" id="{{ input_id }}" placeholder="{{ item.placeholder|html_sanitize }}" required="{{ item.is_required ? 'required' }}">
                    {% endif %}
                    {% if item.is_required %}
                        <div class="required-message">Dieses Feld muss ausgefüllt sein.</div>
                    {% endif %}
                {% endfor %}
                <div class="checkbox-group">
                    <input type="checkbox" name="{{ block.label }}" id="checkbox-{{ block.label|replace({' ': '-'})|lower }}" required>
                    <label for="checkbox-{{ block.label|replace({' ': '-'})|lower }}" class="checkbox-label">
                        {{ block.label|html_sanitize }}
                    </label>
                </div>
                <div class="btn-container">
                    <a data-action="click->form#validateForm" class="theme-cta cta theme-button">{{ block.ctaTitle }}</a>
                </div>
            </form>

        </div>
    </div>
</div>
